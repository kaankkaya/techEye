{
  "expo": {
    "name": "eyeTech",
    "slug": "eyetech",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "eyeTech uses the camera to detect nearby objects and people.",
        "NSMicrophoneUsageDescription": "eyeTech uses the microphone for audio feedback.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.kaankaya.eyetech"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "eyeTech uses the camera to detect nearby objects and people."
        }
      ],
      "expo-splash-screen",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "49a425d4-cffe-4c53-b432-592cdd24c573"
      }
    },
    "owner": "rohnin"
  }
}
